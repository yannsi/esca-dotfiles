// -*- mode: jsonc -*-
{
    "spacing": 4, // モジュール間のギャップ (4px)

    // モジュールの配置順序
    "modules-left": [
        "custom/menu",
        "niri/workspaces",
        "custom/folder",
        "custom/firefox",
        "custom/chrome",
        "custom/radio",
        "custom/media"
    ],
    "modules-center": [
        "niri/window",
        "custom/cava"
    ],
    "modules-right": [
        "wireplumber",
        "custom/backlight",
        "tray",
        "custom/weather",
        "clock",
        "custom/power"
    ],

    // =========================================================================
    // Modules: Left
    // =========================================================================

    // アプリケーションメニュー (Fuzzel)
    "custom/menu": {
        "format": "  ",
        "tooltip": true,
        "tooltip-format": "メニュー",
        "on-click": "$HOME/.config/waybar/scripts/fuzzel_toggle.sh"
    },

    // Niri ワークスペース一覧
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": ""
        }
    },

    // ファイルマネージャー
    "custom/folder": {
        "format": "  ",
        "tooltip": true,
        "tooltip-format": "ファイルマネージャー",
        "on-click": "nautilus",
        "on-click-right": "killall nautilus",
        "on-click-middle": "alacritty -e ranger"
    },

    // Firefox ブラウザ
    "custom/firefox": {
        "format": "  ",
        "tooltip": true,
        "tooltip-format": "Firefox ブラウザ",
        "on-click": "firefox"
    },

    // Google Chrome / Chromium（未インストール時は自動で非表示）
    "custom/chrome": {
        "format": "{}",
        "return-type": "json",
        "exec": "if command -v google-chrome-stable >/dev/null 2>&1; then echo '{\"text\":\"  \",\"tooltip\":\"Google Chrome\"}'; elif command -v chromium >/dev/null 2>&1; then echo '{\"text\":\"  \",\"tooltip\":\"Chromium\"}'; fi",
        "interval": "once",
        "on-click": "google-chrome-stable || google-chrome || chromium"
    },

    // インターネットラジオ（Fuzzelセレクター）
    "custom/radio": {
        "format": "  ",
        "tooltip": true,
        "tooltip-format": "インターネットラジオ（左クリック: 局選択 / 右クリック: 停止）",
        "on-click": "bash $HOME/.config/waybar/scripts/radiostation.sh",
        "on-click-right": "pkill -x mpv",
        "on-click-middle": "bash $HOME/.config/waybar/scripts/radiostation.sh"
    },

    // メディア再生情報 (MPRIS / Playerctl)
    "custom/media": {
        "format": " {icon}{text} ",
        "return-type": "json",
        "format-icons": {
            "Playing": " ",
            "Paused": " ",
            "stop": " "
        },
        "max-length": 70,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{playerName}}: {{artist}}  {{markup_escape(title)}}\", \"tooltip\": \"{{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "on-click": "playerctl play-pause",
        "on-click-middle": "alacritty -e cava",
        "on-click-right": "playerctl stop"
    },

    // =========================================================================
    // Modules: Center
    // =========================================================================

    // アクティブウィンドウタイトル
    "niri/window": {
        "format": "{}",
        "max-length": 50
    },

    // CAVA オーディオビジュアライザー
    "custom/cava": {
        "exec": "/home/sk/.config/waybar/scripts/waybar_cava.py",
        "format": "{}",
        "return-type": "plaintext",
        "tooltip": false
    },

    // =========================================================================
    // Modules: Right
    // =========================================================================

    // 音量 (WirePlumber)
    "wireplumber": {
        "format": " {icon}{volume}% ",
        "return-type": "json",
        "format-muted": " 󰝟 ",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && sleep 1",
        "on-click-right": "alacritty -e alsamixer",
        "max-volume": 150,
        "scroll-step": 0.7,
        "tooltip": true,
        "tooltip-format": "音量（マウスホイールで調節・右クリックで alsamixer が開きます）"
    },

    // バックライト輝度調整
    "custom/backlight": {
        "format": "  ",
        "tooltip": true,
        "tooltip-format": "バックライト(左クリック：明るくなる | 右クリック：暗くなる)",
        "on-click": "brightnessctl s +4%",
        "on-click-right": "brightnessctl s 4%-"
    },

    // システムトレイ
    "tray": {
        "spacing": 10
    },

    // 天気予報
    "custom/weather": {
        "format": "{}",
        "tooltip": true,
        "interval": 3600,
        "exec": "$HOME/.config/waybar/scripts/get_weather.py",
        "return-type": "json",
        "signal": 9,
        "on-click-right": "$HOME/.config/waybar/scripts/set_weather_location.sh"
    },

    // 時計 & カレンダー（Waybar内蔵モジュール・ホバーで月間カレンダー表示）
    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%Y-%m-%d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
                "weekdays": "<span color='#fab387'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // 電源メニュー (Rofi)
    "custom/power": {
        "format": "  ",
        "tooltip": false,
        "on-click": "$HOME/.config/waybar/scripts/power_menu_toggle.sh"
    }
}
